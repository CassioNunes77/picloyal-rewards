rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // REGIÕES (LOCALIZAÇÃO)
    // ============================================
    match /regions/{regionId} {
      // Permitir leitura de todas as regiões (necessário para o painel administrativo)
      // Em produção, considere adicionar verificação de admin ou autenticação Firebase
      allow read: if true;
      
      // Apenas usuários autenticados podem criar, atualizar ou deletar
      // Em produção, adicione verificação de admin aqui
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['name', 'state', 'city', 'country', 'active']) &&
                       request.resource.data.name is string &&
                       request.resource.data.state is string &&
                       request.resource.data.city is string &&
                       request.resource.data.country is string &&
                       request.resource.data.active is bool &&
                       request.resource.data.createdAt is timestamp &&
                       request.resource.data.updatedAt is timestamp;
      
      allow update: if request.auth != null &&
                       request.resource.data.updatedAt is timestamp &&
                       // Garantir que campos obrigatórios não sejam removidos
                       request.resource.data.keys().hasAll(['name', 'state', 'city', 'country', 'active']);
      
      allow delete: if request.auth != null;
    }
    
    // ============================================
    // CATEGORIAS
    // ============================================
    match /categories/{categoryId} {
      // Permitir leitura de todas as categorias (necessário para o painel administrativo)
      // Em produção, considere adicionar verificação de admin ou autenticação Firebase
      allow read: if true;
      
      // Apenas usuários autenticados podem criar, atualizar ou deletar
      // Em produção, adicione verificação de admin aqui
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['name', 'icon', 'active', 'productsCount']) &&
                       request.resource.data.name is string &&
                       request.resource.data.icon is string &&
                       request.resource.data.active is bool &&
                       request.resource.data.productsCount is int &&
                       request.resource.data.createdAt is timestamp &&
                       request.resource.data.updatedAt is timestamp &&
                       // Validações adicionais
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.icon.size() > 0 &&
                       request.resource.data.productsCount >= 0;
      
      allow update: if request.auth != null &&
                       request.resource.data.updatedAt is timestamp &&
                       // Garantir que campos obrigatórios não sejam removidos
                       request.resource.data.keys().hasAll(['name', 'icon', 'active', 'productsCount']) &&
                       // Validar tipos
                       request.resource.data.name is string &&
                       request.resource.data.icon is string &&
                       request.resource.data.active is bool &&
                       request.resource.data.productsCount is int &&
                       request.resource.data.productsCount >= 0;
      
      allow delete: if request.auth != null;
    }
    
    // ============================================
    // ADMINISTRADORES (painel admin)
    // ============================================
    // Coleção admins: documento com ID = uid do Firebase Auth.
    // Usuário pode ler seu próprio doc; admins podem ler todos (para tela de administradores).
    // Criação/edição de admins: manual via Firebase Console (ou script create-admin-user).
    match /admins/{adminId} {
      allow read: if request.auth != null &&
        (request.auth.uid == adminId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow write: if false;
    }

    // ============================================
    // USUÁRIOS
    // ============================================
    match /users/{userId} {
      // Permitir leitura de todos os usuários (necessário para o painel administrativo)
      // Em produção, considere adicionar verificação de admin ou autenticação Firebase
      allow read: if true;
      
      // Usuários podem criar/atualizar apenas seus próprios dados
      // Permitir atualização do campo 'role' quando se registra como lojista
      allow create, update: if request.auth != null && 
                               request.auth.uid == userId &&
                               // Validar que role seja 'user' ou 'merchant' se fornecido
                               (!request.resource.data.keys().hasAny(['role']) ||
                                request.resource.data.role == 'user' ||
                                request.resource.data.role == 'merchant');
      
      // Usuários não podem deletar seus próprios dados (apenas admin)
      allow delete: if false;
    }
    
    // ============================================
    // LOJISTAS (MERCHANTS)
    // ============================================
    match /merchants/{merchantId} {
      // Lojistas podem ler seus próprios dados
      // Usuários autenticados podem ler todos os lojistas (para painel administrativo)
      allow read: if request.auth != null;
      
      // Lojistas podem criar apenas seus próprios dados quando se registram
      // O merchantId deve corresponder ao uid do usuário autenticado
      allow create: if request.auth != null && 
                        request.auth.uid == merchantId &&
                        request.resource.data.uid == request.auth.uid &&
                        request.resource.data.email is string &&
                        request.resource.data.email.size() > 0 &&
                        request.resource.data.createdAt is timestamp &&
                        request.resource.data.updatedAt is timestamp;
      
      // Lojistas podem atualizar apenas seus próprios dados
      // Não permitir alteração do uid ou email
      allow update: if request.auth != null && 
                       request.auth.uid == merchantId &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.updatedAt is timestamp;
      
      // Lojistas não podem deletar seus próprios dados (apenas admin)
      allow delete: if false;
    }
    
    // ============================================
    // LOJAS (STORES)
    // ============================================
    match /stores/{storeId} {
      // Qualquer um pode ler lojas (público)
      // Em produção, considere filtrar apenas lojas ativas
      allow read: if true;
      
      // Apenas lojistas autenticados podem criar lojas
      // O merchantId deve corresponder ao uid do usuário autenticado
      // Verificar se o usuário existe na coleção merchants
      allow create: if request.auth != null &&
                       request.resource.data.merchantId == request.auth.uid &&
                       exists(/databases/$(database)/documents/merchants/$(request.auth.uid)) &&
                       request.resource.data.keys().hasAll(['merchantId', 'name', 'cnpj', 'address', 'city', 'phone', 'hours', 'active']) &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.cnpj is string &&
                       request.resource.data.cnpj.size() > 0 &&
                       request.resource.data.address is string &&
                       request.resource.data.address.size() > 0 &&
                       request.resource.data.city is string &&
                       request.resource.data.city.size() > 0 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() > 0 &&
                       request.resource.data.hours is string &&
                       request.resource.data.active is bool &&
                       request.resource.data.createdAt is timestamp &&
                       request.resource.data.updatedAt is timestamp;
      
      // Lojistas podem atualizar apenas suas próprias lojas
      // Admins (users com isAdmin: true) podem atualizar qualquer loja (ex.: habilitar/desabilitar)
      allow update: if request.auth != null && (
                       (resource.data.merchantId == request.auth.uid &&
                        request.resource.data.merchantId == resource.data.merchantId &&
                        request.resource.data.updatedAt is timestamp &&
                        request.resource.data.keys().hasAll(['merchantId', 'name', 'cnpj', 'address', 'city', 'phone', 'hours', 'active'])) ||
                       (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
                        request.resource.data.updatedAt is timestamp));
      
      // Lojistas podem deletar apenas suas próprias lojas
      allow delete: if request.auth != null && 
                       resource.data.merchantId == request.auth.uid;
    }
    
    // ============================================
    // OFERTAS (OFFERS)
    // ============================================
    // Ofertas das lojas: leitura pública; criar/atualizar/deletar apenas o lojista dono
    match /offers/{offerId} {
      allow read: if true;
      allow create: if request.auth != null
                       && request.resource.data.merchantId == request.auth.uid
                       && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
                       && request.resource.data.keys().hasAll(['storeId', 'merchantId', 'title', 'description', 'category', 'validUntil', 'active', 'createdAt', 'updatedAt'])
                       && request.resource.data.storeId is string
                       && request.resource.data.merchantId is string
                       && request.resource.data.title is string
                       && request.resource.data.description is string
                       && request.resource.data.category is string
                       && request.resource.data.validUntil is timestamp
                       && request.resource.data.active is bool
                       && request.resource.data.createdAt is timestamp
                       && request.resource.data.updatedAt is timestamp;
      allow update, delete: if request.auth != null
                               && resource.data.merchantId == request.auth.uid;
    }

    // ============================================
    // CARIMBOS (STAMP REWARDS)
    // ============================================
    match /stampRewards/{stampId} {
      allow read: if true;
      allow create: if request.auth != null
                       && request.resource.data.merchantId == request.auth.uid
                       && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
                       && request.resource.data.keys().hasAll(['storeId', 'merchantId', 'totalStamps', 'rewardTitle', 'active', 'createdAt', 'updatedAt'])
                       && request.resource.data.storeId is string
                       && request.resource.data.merchantId is string
                       && request.resource.data.totalStamps is int
                       && request.resource.data.totalStamps >= 2
                       && request.resource.data.totalStamps <= 100
                       && request.resource.data.rewardTitle is string
                       && request.resource.data.rewardTitle.size() > 0
                       && request.resource.data.active is bool
                       && request.resource.data.createdAt is timestamp
                       && request.resource.data.updatedAt is timestamp;
      allow update, delete: if request.auth != null
                               && resource.data.merchantId == request.auth.uid;
    }

    // ============================================
    // RESGATES DE OFERTAS (REDEMPTIONS)
    // ============================================
    match /offerRedemptions/{redemptionId} {
      // Lojistas podem ler resgates das suas lojas; usuários podem ler seus próprios resgates
      allow read: if request.auth != null &&
                       (resource.data.merchantId == request.auth.uid ||
                        resource.data.userId == request.auth.uid);
      
      // Usuários autenticados podem criar resgate (ao usar oferta)
      // userId deve ser o próprio usuário; validar campos obrigatórios
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['offerId', 'offerTitle', 'storeId', 'storeName', 'merchantId', 'userId', 'userName', 'userEmail', 'status', 'createdAt']) &&
                       request.resource.data.offerId is string &&
                       request.resource.data.offerTitle is string &&
                       request.resource.data.storeId is string &&
                       request.resource.data.storeName is string &&
                       request.resource.data.merchantId is string &&
                       request.resource.data.userId is string &&
                       request.resource.data.userName is string &&
                       request.resource.data.userEmail is string &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdAt is timestamp;
      
      // Lojista pode confirmar resgate (atualizar status para confirmed)
      allow update: if request.auth != null &&
                       resource.data.merchantId == request.auth.uid &&
                       request.resource.data.status == 'confirmed';
      
      allow delete: if false;
    }

    // ============================================
    // ATIVIDADES DO USUÁRIO
    // ============================================
    match /userActivities/{activityId} {
      // Usuário lê apenas suas próprias atividades
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Usuário cria atividade para si; lojista pode atualizar (ex: confirmar resgate)
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'type', 'title', 'description', 'storeName', 'createdAt']) &&
                       request.resource.data.userId is string &&
                       request.resource.data.type is string &&
                       request.resource.data.title is string &&
                       request.resource.data.description is string &&
                       request.resource.data.storeName is string &&
                       request.resource.data.createdAt is timestamp &&
                       (!request.resource.data.keys().hasAny(['merchantId']) || request.resource.data.merchantId is string);
      allow update: if request.auth != null &&
                       (resource.data.userId == request.auth.uid ||
                        (resource.data.merchantId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['status']) &&
                         request.resource.data.status is string));
      allow delete: if false;
    }

    // ============================================
    // COMPARTILHAMENTOS (analytics)
    // ============================================
    match /offerShareEvents/{eventId} {
      allow read: if false;
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['offerId', 'shareType', 'createdAt']) &&
                       request.resource.data.offerId is string &&
                       request.resource.data.shareType is string &&
                       request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    // ============================================
    // NOTIFICAÇÕES (usuário)
    // ============================================
    match /notifications/{notificationId} {
      // Usuário pode ler apenas suas próprias notificações
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Usuário pode atualizar (marcar como lida) apenas suas próprias notificações
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Usuários podem criar notificações para si (ex: welcome); lojistas podem criar para usuários (ex: resgate confirmado)
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['userId', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
                       request.resource.data.userId is string &&
                       request.resource.data.type is string &&
                       request.resource.data.title is string &&
                       request.resource.data.message is string &&
                       request.resource.data.isRead is bool &&
                       request.resource.data.createdAt is timestamp &&
                       (request.resource.data.userId == request.auth.uid ||
                        exists(/databases/$(database)/documents/merchants/$(request.auth.uid)));
      
      allow delete: if false;
    }

    // ============================================
    // CONTEÚDO DO APP (ex.: Política de Privacidade)
    // ============================================
    // Documento único editável no painel administrativo; leitura pública para exibir em todas as telas
    // Permite criar/atualizar política de privacidade: usuário autenticado no Firebase Auth (ex.: admin)
    match /appContent/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // ============================================
    // OUTRAS COLEÇÕES
    // ============================================
    // Por padrão, negar acesso a outras coleções não especificadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
