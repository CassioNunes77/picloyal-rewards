# Firebase - copie para .env e preencha com os dados do seu projeto no Firebase Console
VITE_FIREBASE_API_KEY=

# ImgBB - chave gratuita em https://api.imgbb.com/ (para upload de fotos de loja)
VITE_IMGBB_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Painel admin: login via Firebase Auth (e-mail/senha). Adicione o UID do usuário na coleção "admins" do Firestore.

# Stripe - assinatura Premium na Web
# URL da Cloud Function ou API que cria a Stripe Checkout Session.
# Ex: https://us-central1-SEU_PROJECT.cloudfunctions.net/createCheckoutSession
VITE_STRIPE_CHECKOUT_ENDPOINT=
