# Firebase - copie para .env e preencha com os dados do seu projeto no Firebase Console
VITE_FIREBASE_API_KEY=

# ImgBB - chave gratuita em https://api.imgbb.com/ (para upload de fotos de loja)
VITE_IMGBB_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
